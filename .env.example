# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional API key for DeepSeek models (https://api.deepseek.com)
DEEPSEEK_API_KEY=""

# DEEPSEEK_BASE_URL: Optional OpenAI-compatible base URL (defaults to https://api.deepseek.com)
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# QWEN_API_KEY / DASHSCOPE_API_KEY: Optional API key for Qwen / Alibaba Cloud Bailian MaaS models
QWEN_API_KEY=""
DASHSCOPE_API_KEY=""

# QWEN_BASE_URL: OpenAI-compatible base URL for Qwen (defaults to https://llm-an182rqwrbwslp1n.cn-beijing.maas.aliyuncs.com/compatible-mode/v1)
QWEN_BASE_URL="https://llm-an182rqwrbwslp1n.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# ZHIPU_API_KEY / GLM_API_KEY: Optional API key for Tsinghua Zhipu AI (GLM) models (https://open.bigmodel.cn)
ZHIPU_API_KEY=""
GLM_API_KEY=""

# ZHIPU_BASE_URL: OpenAI-compatible base URL for Zhipu AI (defaults to https://open.bigmodel.cn/api/paas/v4)
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

